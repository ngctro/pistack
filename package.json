{
  "name": "@ngctro/pistack",
  "version": "0.1.1",
  "description": "Native pi port of poteto's pstack engineering workflows, agents, and automation tools",
  "type": "module",
  "license": "MIT",
  "author": "ngctro",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngctro/pistack.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pstack",
    "agents"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "extensions",
    "skills",
    "agents",
    "automations",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "upstream.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:upstream": "cd skills/poteto-mode/scripts && bun test orch watch-pr",
    "verify": "npm run check && npm test && npm run test:upstream",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "^0.85.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
